PORT=3000
# demo ou sqlserver. O modo demo não persiste pedidos.
DATA_MODE=demo
ADMIN_TOKEN=
SQL_HOST=localhost
SQL_PORT=1433
SQL_DATABASE=Floricultura
SQL_USER=floricultura_app
SQL_PASSWORD=
SQL_TRUST_CERTIFICATE=false
# Opcional: caminho de um Chrome/Chromium instalado. Vazio usa o Chrome do Puppeteer.
WHATSAPP_BROWSER_PATH=

# false abre a janela do navegador no computador para diagnóstico da conexão.
WHATSAPP_HEADLESS=true

# IA Florzinha (opcional). Preencha a chave somente no .env local; nunca envie ao Git.
FLORZINHA_API_KEY=
FLORZINHA_MODEL=gpt-4.1-mini
