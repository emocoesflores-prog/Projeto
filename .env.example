# Configuração completa do aplicativo 3.16.2.
# Nunca substitua senhas/chaves existentes por valores deste exemplo.
# Desenvolvimento local: mantenha COOKIE_SECURE=false.
# Produção HTTPS: NODE_ENV=production, COOKIE_SECURE=true e origens públicas exatas.
NODE_ENV=development
PORT=3000
# demo não persiste os pedidos. Para usar o banco real: sqlserver.
DATA_MODE=demo
# multi usa contas individuais e separação entre floriculturas.
AUTH_MODE=multi
# Inicialização do administrador: mínimo de 16 caracteres; preserve o valor existente.
ADMIN_TOKEN=

# SQL Server: copie os dados da instalação que já está funcionando.
SQL_HOST=localhost
SQL_PORT=1433
SQL_DATABASE=Floricultura
SQL_USER=floricultura_app
SQL_PASSWORD=
# TLS permanece habilitado no código. true aceita certificado não confiável: somente servidor conhecido.
SQL_TRUST_CERTIFICATE=false

# Origem = protocolo + domínio/host + porta, sem /painel, slug ou caminho.
COOKIE_SECURE=false
APP_ORIGIN=http://localhost:3000
# Domínio da plataforma. Domínios próprios são configurados no cadastro de cada loja.
PLATFORM_PUBLIC_URL=https://inovafacil.com.br

# WhatsApp Web: não precisa de token Meta nem de chaves OAuth.
# Vazio utiliza o Chrome do Puppeteer; se preenchido, informe um executável existente.
WHATSAPP_BROWSER_PATH=
# true mostra o navegador para diagnóstico. O padrão do atendimento é false.
WHATSAPP_SHOW_BROWSER=false

# Assistente opcional: chave padrão do servidor. Cada loja também pode salvar sua chave no painel.
FLORZINHA_API_KEY=
FLORZINHA_MODEL=gpt-4.1-mini
# Roteirização rodoviária opcional: chave padrão OpenRouteService.
ORS_API_KEY=

# Canais OAuth: em produção, informe a origem HTTPS pública da aplicação.
# localhost só serve para testes locais aceitos pelo provedor; Meta exige origem pública apropriada.
CHANNELS_PUBLIC_URL=http://localhost:3000
# Chave AES de 32 bytes em base64. Gere UMA VEZ e preserve nos backups.
CHANNELS_ENCRYPTION_KEY=
# Credenciais do aplicativo Meta da plataforma, não da conta de cada floricultura.
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v24.0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Armazenamento privado: deixe vazio para manter as pastas padrão do projeto.
# Se já usa caminhos personalizados, preserve os mesmos caminhos e os arquivos.
PRODUCT_MEDIA_ROOT=
ORDER_UPLOAD_ROOT=
# Cota de fotos dos pedidos por loja em MB; padrão 5120, mínimo aplicado de 512.
ORDER_UPLOAD_QUOTA_MB=5120

# Links privados de entregadores/rastreio: preserve a chave existente.
# Vazio usa/gera .driver-access/key; preserve essa pasta.
# Se já definiu uma chave no ambiente, mantenha EXATAMENTE a mesma chave base64 de 32 bytes.
DRIVER_ACCESS_KEY=
