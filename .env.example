PORT=3000
# demo ou sqlserver. O modo demo não persiste pedidos.
DATA_MODE=demo
ADMIN_TOKEN=
SQL_HOST=localhost
SQL_PORT=1433
SQL_DATABASE=Floricultura
SQL_USER=floricultura_app
SQL_PASSWORD=
SQL_TRUST_CERTIFICATE=false
# Opcional: caminho de um Chrome/Chromium instalado. Vazio usa o Chrome do Puppeteer.
WHATSAPP_BROWSER_PATH=

# Opcional: true mostra o navegador apenas para diagnóstico. O atendimento ocorre no painel.
WHATSAPP_SHOW_BROWSER=false

# IA Florzinha (opcional). Preencha a chave somente no .env local; nunca envie ao Git.
FLORZINHA_API_KEY=
FLORZINHA_MODEL=gpt-4.1-mini

# multi = usuários/senhas e lojas separadas (padrão). legacy mantém somente a instalação antiga.
AUTH_MODE=multi
# Produção exige HTTPS e COOKIE_SECURE=true. Em localhost use false.
COOKIE_SECURE=false
# Em produção, informe a origem pública exata (ex.: https://painel.suaempresa.com.br).
APP_ORIGIN=
